<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- 读系统日志（可选）：普通应用拿不到，要用 Shizuku 或电脑 adb 执行一次 pm grant 才有 -->
  <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
  <!-- 能看到 Shizuku 是否安装（安卓 11 起要声明） -->
  <queries>
    <package android:name="moe.shizuku.privileged.api" />
  </queries>
  <!-- 不联网：去掉编译工具默认加的网络权限 -->
  <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
  <application android:label="困兽玩法推理" android:supportsRtl="true" android:largeHeap="true">
    <!-- Shizuku 通过它把授权交给本软件（读游戏日志用，可选） -->
    <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="com.zh.tartarussolver.shizuku"
              android:multiprocess="false" android:enabled="true" android:exported="true"
              android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
  </application>
</manifest>
