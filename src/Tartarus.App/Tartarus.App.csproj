<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell: click-through overlay over the game + small control window. JIT (WPF). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Off: .NET 9's hardware stack protection fails at the start on Windows 10 with a CPU that has it
         ("Assert failure: !AreShadowStacksEnabled() || UseSpecialUserModeApc()", GitHub issue 1). -->
    <CETCompat>false</CETCompat>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TartarusSolver</AssemblyName>
    <!-- 中文版：程序图标和文件属性里的中文名（exe 在发布包里改名为“塔罗斯监狱求解器.exe”） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>塔罗斯监狱求解器</Product>
    <AssemblyTitle>塔罗斯监狱求解器</AssemblyTitle>
    <Company>塔罗斯监狱求解器中文版</Company>
    <Copyright>原作者 Artem Gurevich（glcoder/TartarusSolver），MIT 协议</Copyright>
    <RootNamespace>Tartarus.App</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Where bug reports go (BugReports.DefaultDsn): kept out of the source, passed at build time. -->
    <SentryDsn Condition="'$(SentryDsn)' == ''">$(TARTARUS_SENTRY_DSN)</SentryDsn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The interface's lines: Strings.resx in English, one Strings.<culture>.resx per language (a satellite assembly each). -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
    <AssemblyMetadata Include="TartarusUpstream" Value="$(TartarusUpstream)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tartarus.Vision\Tartarus.Vision.csproj" />
    <ProjectReference Include="..\Tartarus.Solver\Tartarus.Solver.csproj" />
    <ProjectReference Include="..\Tartarus.Capture\Tartarus.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\AppFiles.cs" Link="AppFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Sentry" Version="6.12.1" />
  </ItemGroup>
</Project>
